  "additional_probes": {
    "commit-race": {
      "computed_before_revocation": true,
      "committed_status": "needs_information",
      "candidate_artifacts": 0,
      "recorded_current_revocations": true,
      "synthetic_demo_only": true,
      "source_sha256": "325e83b68e5206b2abb5f70021b3c59b9853a1204d8e3ef1ff948350351a5ee3",
      "source": "\"\"\"Synthetic commit-boundary experiment — DR-061 / DR-064 / DR-065.\"\"\"\nimport json\nfrom pathlib import Path\nimport tempfile\nfrom unittest.mock import patch\n\nfrom domains.robotics import generation\nfrom domain_runs import RunStore\nfrom ontology_assets.governance import GovernanceService\nfrom tests.robotics_governance_support import evidence_spec, save_args, review, publish_args\nfrom tests.robotics_support import S, FIXTURES\nfrom tests.storage_pipeline_support import setup_assets, generate, pipeline\n\nwith tempfile.TemporaryDirectory(prefix='ir019-commit-race-') as raw:\n    root, assets, asset, version, _ = setup_assets(Path(raw),mode='demo')\n    service = GovernanceService(root)\n    oid, revision = asset['ontology_id'],0\n    for index,(kind,impl,slot) in enumerate([\n        ('grasp_compatibility',S.grasp_Subtree_Impl,None),\n        ('placement_compatibility',S.Place_Subtree_Impl,S.Slot_B_01),\n    ]):\n        spec=evidence_spec(iri=str(S[f'ProbeEvidence{index}']),kind=kind,implementation=str(impl),\n            slot=str(slot) if slot else None,reference='demo-only:commit-race-probe',\n            valid_until='2999-01-01T00:00:00+00:00')\n        args=save_args(version,revision=revision,request_id=f'reg-{index}');del args['operations']\n        version=service.register_evidence(oid,evidence=spec,**args);revision+=1\n        args=save_args(version,revision=revision,request_id=f'review-{index}');del args['operations']\n        version=service.review_evidence(oid,evidence_iri=spec['iri'],decision='accepted',**args);revision+=1\n    reviewed=review(service,oid,version,request_id=\"final-version-review\")\n    version=service.publish(oid,**publish_args(version,reviewed,revision=revision))\n    original=generation.generate_task\n    computed=[]\n    def revoke_after_computation(*args,**kwargs):\n        result=original(*args,**kwargs)\n        assert result['status']=='generated'\n        computed.append(result['candidate_written'])\n        service.revoke_evidence(oid,evidence_iri=str(S.ProbeEvidence0),version_id=version['version_id'],\n            actor='synthetic reviewer',reason='revoked during compute',request_id='race-revoke')\n        return result\n    task=json.loads((FIXTURES/'demo_supplement.json').read_text())['task']\n    with patch.object(generation,'generate_task',revoke_after_computation):\n        run=generate(pipeline(),root,asset,version,task,mode='demo')\n    assert computed==[True]\n    assert run['result']['status']=='needs_information'\n    assert run['result']['candidate_written'] is False\n    assert any(i['code']=='evidence_revoked' for i in run['result']['issues'])\n    artifacts=RunStore(root).artifacts(run['run_id'])\n    assert not any(a['kind']=='candidate' for a in artifacts)\n    assert run['result']['evidence_check']['revocation_ids']\n    print(json.dumps({'computed_before_revocation':True,'committed_status':run['result']['status'],\n        'candidate_artifacts':0,'recorded_current_revocations':True,'synthetic_demo_only':True}))\n"
    },
    "rebuild-chain": {
      "rebuilds": 2,
      "foreign_source_baseline": true,
      "manual_label_preserved": true,
      "source_threshold": "0.74",
      "unproven_baseline_rejected": true,
      "source_sha256": "36574afebcb387d739a7a08b105929297e56bd62817c2a61b100ce38ce79a190",
      "source": "\"\"\"Real repeated source builds and explicit lineage experiment — DR-060 / DR-064 / DR-065.\"\"\"\nimport json\nfrom pathlib import Path\nimport tempfile\nimport xml.etree.ElementTree as ET\nfrom rdflib import Graph, RDFS\nfrom ontology_assets import AssetStore\nfrom ontology_assets.governance import GovernanceService, GovernanceError\nfrom tests.robotics_governance_support import actual_build, save_args\nfrom tests.robotics_support import S, SOURCE\n\nwith tempfile.TemporaryDirectory(prefix='ir019-rebuild-chain-') as raw:\n    root=Path(raw)/'storage'\n    base,_=actual_build(root,name='base')\n    service=GovernanceService(root)\n    oid=base['ontology_id']\n    current=service.save(oid,**save_args(base))\n    revision=1\n    for index,threshold in enumerate(['0.73','0.74']):\n        tree=ET.fromstring(SOURCE.read_bytes())\n        tree.find(\"BehaviorTree[@ID='main']/Sequence\")[4].set('threshold',threshold)\n        incoming,_=actual_build(root,name=f'incoming-{index}',source=ET.tostring(tree))\n        args={name:{k:v[k] for k in ['ontology_id','version_id','payload_sha256']}\n              for name,v in [('base',base),('current',current),('incoming',incoming)]}\n        args.update(expected_head_version_id=current['version_id'],expected_revision=revision)\n        preview=service.preview_merge(oid,**args)\n        assert not preview['conflicts']\n        current=service.commit_merge(oid,merge_token=preview['merge_token'],inputs=args,decisions={},\n            request_id=f'merge-{index}',actor='synthetic reviewer',reason='explicit rebuild chain')\n        revision+=1\n        base=incoming\n    g=Graph().parse(data=AssetStore(root).read_payload(oid,current['version_id']),format='xml')\n    assert str(g.value(S.Perception_Current,S.threshold))=='0.74'\n    assert str(g.value(S.PartType_A,RDFS.label))=='人工零件类型'\n    assert current['metadata']['source_baseline']['ontology_id']!=oid\n    try:\n        service.preview_merge(oid,base={'ontology_id':oid,'version_id':current['version_id'],\n            'payload_sha256':current['payload_sha256']},current={k:current[k] for k in ['ontology_id','version_id','payload_sha256']},incoming=args['incoming'],\n            expected_head_version_id=current['version_id'],expected_revision=revision)\n    except GovernanceError as error:\n        assert error.code=='merge_conflict' and '来源构建基线' in str(error)\n    else: raise AssertionError('A manual candidate cannot masquerade as a source build')\n    print(json.dumps({'rebuilds':2,'foreign_source_baseline':True,'manual_label_preserved':True,\n                      'source_threshold':'0.74','unproven_baseline_rejected':True}))\n"
    }
