# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── 数据底座 ─────────────────────────────────────────────
# 仓库根的运行期数据库不入库;示例库在 examples/demo_metrics.db(已脱敏,随仓分发)
/demo_metrics.db
*.db-journal
*.db-wal

# ── 凭据与连接配置:务必不入库 ────────────────────────────
.env
workdir/conn_secrets.json
# 凭据静态加密的本机主密钥(0600)。注释必须独占一行 —— .gitignore 不支持行尾注释,
# 写成 `路径  # 说明` 会让整行变成一个匹配不到文件的 pattern,密钥反而照样入库。
workdir/.conn_key
workdir/engine_config.json
workdir/build_connections.json

# ── 运行时产物:日志 ────────────────────────────────────
workdir/*.log

# ── 运行时产物:会话与可变状态 ──────────────────────────
# 由应用在运行中读-改-写。demo 分支下这批作为「开箱可演示」的种子数据入库
# (见 examples/README-demo.md);日常开发若不希望产生 diff,可用 skip-worktree。
workdir/edits_*.json
# 编辑栈留底(server.py rebuild 时改名而非删除),属运行期产物
workdir/*.discarded
workdir/viz_boards.json

# ── 用户上传与派生库 ────────────────────────────────────
workdir/uploads.db
workdir/uploads_*
workdir/chat_uploads/
workdir/custom_skills/
# 技能删除墓碑(内置技能的删除记录)。属本机偏好,与运行状态同类,不入库。
workdir/skill_deleted.json

# ── 临时脚本 ────────────────────────────────────────────
workdir/_*.py

# ── 操作系统 ────────────────────────────────────────────
.DS_Store

# IR-007 测试产物
.coverage
.pytest_cache/
htmlcov/
.ruff_cache/
.mypy_cache/

# ── 外部审计报告 ────────────────────────────────────────
# 随检测批次生成的外部产物(检查cosmo-datamind开源文件<时间戳>.docx),不随代码留档。
# 只忽略仓库根一层,docs/ 下的项目文档不受影响。
/*.docx

# ── 扫描报告与办公文档:一律不入库 ──────────────────────
# 漏洞/网站扫描报告(含内网IP与安全信息)
*扫描*.pdf
网站任务_*.pdf
# 仓库根目录的办公文档与压缩包(文档图片 docs/img/ 不受影响)
/*.pdf
/*.docx
/*.xlsx
/*.pptx
/*.zip
# 用户上传文件的运行时落盘
workdir/uploads_*
# Isolated local/CI validation logs (never product runtime state)
.check-results/
# Local persistent deployment state, private backups and logs.
.deploy/

# ── 公司交付物文档 ──────────────────────────────────────
deliverables/
