# Cosmo DataMind 环境变量样例
#   cp .env.example .env  然后按需填写;.env 已被 .gitignore 排除,切勿提交。
#   所有变量均可留空——留空时相关功能会如实降级并在界面标注,不会静默失败。

# ── 路径 ────────────────────────────────────────────────
# 只读 SQLite 数据底座。缺失时问数/可视化等端点如实报错,不影响服务启动。
DATAMIND_DB=./demo_metrics.db
# 上游本体引擎目录(可选)。缺失则 LLM 构建自动降级为纯数据驱动的 quick_build。
# 本项相对路径按「程序所在目录」解析(不随启动 cwd 变),故写 ../x 与绝对路径同样稳定。
DATAMIND_ENGINE_DIR=../ontology-engine
# 成果库目录(可选)。
DATAMIND_OUTPUTS_DIR=../outputs

# ── 监听 ────────────────────────────────────────────────
# 默认仅监听本机。改为 0.0.0.0 前请自行加反向代理与鉴权——
# 本服务不含用户体系,不可直接暴露到公网。
DATAMIND_HOST=127.0.0.1
DATAMIND_PORT=8092

# ── 安全开关 ────────────────────────────────────────────
# API 数据源取数的 SSRF 严格模式。默认已拦死非 http(s) 协议,以及链路本地
#(含云元数据 169.254.169.254)、未指定、多播与保留段地址;回环与内网默认放行。
# 置 1 则回环与内网也一并禁止:当本服务可能被不可信网络访问时打开,
# 代价是「连内网 API」这类正当用法同时失效。
DATAMIND_BLOCK_INTERNAL_FETCH=
# 日志级别(DEBUG/INFO/WARNING/ERROR)。默认 INFO;排障时设 DEBUG 可看到
# 被有意省略的异常细节(默认不打,是因为其中常含端点地址与本地路径)。
DATAMIND_LOG_LEVEL=
# 「本地自建 LLM」预设在界面上一键填入的端点(仅影响预设值,不影响实际连接)。
DATAMIND_LOCAL_LLM_BASE=

# ── 接入大模型(最常用的一档:任意 OpenAI 兼容端点)────────
# 这四项配齐即可,不需要上游引擎。GLM / DeepSeek / Qwen / 自建 vLLM 都适用。
# 缺 BASE 或 KEY 任一项则该驱动不注册,/api/ont/runtimes 返回空数组——
# 系统据实报「无可用运行时」,不会接受配置却在调用时才失败。
#
#   端点前缀写到 /v1 或 /v4 为止,不要带 /chat/completions
DATAMIND_LLM_BASE=
DATAMIND_LLM_KEY=
DATAMIND_LLM_MODEL=
# 关键:告诉系统优先用上面这个端点。漏掉它的现象是「配了 Key 却没反应」。
CLAW_DRIVER=openai

# 单轮超时(秒),默认 180。推理型模型的思维链耗时计入其中;配紧了会被截断,
# 现象是执行记录里 llm_plan 显示「返回几十字符」随后回退模板。
DATAMIND_LLM_TIMEOUT=
# 单次回复 token 上限,默认 16384。思维链占用同一份额度,配紧了正文会被挤没。
DATAMIND_LLM_MAX_TOKENS=

# 参考配置(智谱 GLM):
#   DATAMIND_LLM_BASE=https://open.bigmodel.cn/api/coding/paas/v4
#   DATAMIND_LLM_MODEL=glm-4.5
# 参考配置(DeepSeek):
#   DATAMIND_LLM_BASE=https://api.deepseek.com/v1
#   DATAMIND_LLM_MODEL=deepseek-chat

# ── 接入上游引擎时的运行时(可选)────────────────────────
# 仅在设置了 DATAMIND_ENGINE_DIR 后可用。把 CLAW_DRIVER 改成下列之一即可切换:
#   hermes | claude-code | openclaw
# 注:openclaw 调用的是本机已安装的 openclaw 命令行;它连哪个网关在 OpenClaw 客户端里配。
CLAUDE_MODEL=
HERMES_MODEL=
HERMES_PROVIDER=
OPENCLAW_MODEL=

# ── 其他模型密钥(供界面「引擎设置」页使用)──────────────
# 环境变量优先于 workdir/engine_config.json;界面上只回显掩码,不回显明文。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# ── 外部数据源凭据 ──────────────────────────────────────
# 外部库(MySQL/Doris/PostgreSQL)的账号密码在「数据连接」页填写,
# 落盘于 workdir/conn_secrets.json(权限 0600、只写不回显、已 gitignore)。
# 不要把生产库凭据写进本文件或任何入库文件。
