  <rdf:Description rdf:about="https://example.org/ur-skill#grasp_Sequence_4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/ur-skill#SkillInvocation"/>
    <rdfs:label xml:lang="zh">grasp / 4 到达抓取位</rdfs:label>
    <s:confirmationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source_extracted</s:confirmationStatus>
    <s:inProcedure rdf:resource="https://example.org/ur-skill#Grasp_Skill"/>
