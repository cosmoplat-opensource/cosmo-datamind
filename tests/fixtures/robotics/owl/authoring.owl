  <rdf:Description rdf:about="https://example.org/ur-skill#GetJoints_BT_Impl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/ur-skill#SkillImplementation"/>
    <rdfs:label xml:lang="zh">GetJoints 节点实现</rdfs:label>
    <s:confirmationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source_extracted</s:confirmationStatus>
    <s:xmlTag rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GetJoints</s:xmlTag>
    <s:nodeKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Condition</s:nodeKind>
    <s:sourceModelXML rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;Condition ID="GetJoints"&gt;
            &lt;output_port name="joints" type="std::vector&amp;lt;double, std::allocator&amp;lt;double&amp;gt; &amp;gt;" /&gt;
