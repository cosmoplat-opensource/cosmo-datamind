@@ -264,6 +268,25 @@ class BIRDReActAgent:
     # Trace Export (for self-evolution)
     # =========================================================================
 
+    def _ontology_check(self, sql: str) -> str:
+        """EVO_DM_CHECK=1: check the final SQL once against the DataMind ontology (/api/ont/check); returns feedback
+        text when it fails, otherwise an empty string. Only the first finish of a session is checked."""
+        import os
+        if os.environ.get("EVO_DM_CHECK") != "1" or getattr(self, "_checked", False) or not sql:
+            return ""
+        self._checked = True
+        try:
+            import static_context
+            g = static_context.dm_graph(self.session.db_id)
+            r = static_context.dm_post("/api/ont/check", {"sql": sql, "graphs": [g]}) if g else {"ok": True}
+        except Exception:  # noqa: BLE001
+            return ""
+        self.ontology_check = {"ok": bool(r.get("ok")), "reason": r.get("reason", "")}
+        if r.get("ok"):
+            return ""
+        return ("The ontology check rejected this SQL: " + str(r.get("reason", ""))[:300]
+                + ". Revise the query (for example use the verified join keys) and finish again.")
+
     def export_trace(self) -> dict:
