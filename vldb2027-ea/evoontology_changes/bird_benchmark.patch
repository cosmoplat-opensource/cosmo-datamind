             if agent_response.get("finish"):
                 sql = self._extract_sql(agent_response.get("content", ""))
+                feedback = self._ontology_check(sql)
+                if feedback:                     # 本文方法:提交前按本体检查一次,不通过则把原因反馈给智能体继续
+                    self.session.messages.append(AgentMessage(role="environment", content=feedback))
