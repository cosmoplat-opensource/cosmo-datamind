  {
    "id": "derived_percentageofrunningloans",
    "name": "PercentageOfRunningLoans",
    "type": "metric",
    "definition": "贷款状态为C的贷款金额占总贷款金额的百分比 Formula: (SUM(CASE WHEN LoanStatus = 'C' THEN LoanAmount ELSE 0 END) / SUM(LoanAmount)) * 100. Inputs: LoanStatus = loan.status; LoanAmount = loan.amount",
    "scope": "derived metric",
    "aliases": [
      "percentage of accounts still running",
      "percentage of running contracts",
      "percentage of running loans"
    ],
    "evidence": []
  },
  {
    "id": "derived_percentageofmaleclientswithweeklystatement",
    "name": "PercentageOfMaleClientsWithWeeklyStatement",
    "type": "metric",
    "definition": "男性客户中请求每周出账的百分比 Formula: (COUNT(DISTINCT CASE WHEN Gender = 'M' AND WeeklyStatement THEN client_id END) / COUNT(DISTINCT CASE WHEN WeeklyStatement THEN client_id END)) * 100. Inputs: Gender = client.gender; WeeklyStatement = account.frequency WHERE frequency IN ('POPLATEK TYDNE')",
    "scope": "derived metric",
    "aliases": [
      "percentage of male clients requesting weekly statements",
      "percentage of male clients with weekly statement"
    ],
    "evidence": []
  },
