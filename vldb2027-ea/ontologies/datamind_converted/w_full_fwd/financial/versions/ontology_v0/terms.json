[
  {
    "id": "term_account",
    "name": "account",
    "type": "entity",
    "definition": "由金融机构开立、用于记录资金收付与余额变动的账户，具有开户日期、对账单频率等属性，并归属于某一地区。 Counterexample: 与银行卡（card）不同：账户是资金记账主体，卡是账户的取用凭证，一个账户可对应多张卡。 Maturity: Provisional",
    "scope": "Records of table account; provenance: direct source account",
    "aliases": [
      "银行账户"
    ],
    "evidence": [
      "ev_schema_account"
    ]
  },
  {
    "id": "term_district",
    "name": "district",
    "type": "entity",
    "definition": "具有行政区划编码与人口、就业等统计属性的地理区域，是账户与客户归属的行政单元。 Counterexample: 与网点（branch）不同：地区是行政统计单元，网点是办理业务的物理场所。 Maturity: Provisional",
    "scope": "Records of table district; provenance: direct source district",
    "aliases": [
      "地区"
    ],
    "evidence": [
      "ev_schema_district"
    ]
  },
  {
    "id": "term_client",
    "name": "client",
    "type": "entity",
    "definition": "在金融机构登记注册、具有性别与出生日期等身份属性并归属某一地区的个人，可持有账户。 Counterexample: 与账户（account）不同：客户是自然人主体，账户是资金载体，二者通过处置关系（disp）多对多关联。 Maturity: Provisional",
    "scope": "Records of table client; provenance: direct source client",
    "aliases": [
      "客户"
    ],
    "evidence": [
      "ev_schema_client"
    ]
  },
  {
    "id": "term_disp",
    "name": "disp",
    "type": "entity",
    "definition": "记录客户对账户所拥有处置权限的关联实体，具有权限类型属性，连接客户与账户。 Counterexample: 与账户（account）不同：处置权是客户与账户之间的授权关系记录，不是资金账户本身。 Maturity: Provisional",
    "scope": "Records of table disp; provenance: direct source disp",
    "aliases": [
      "账户处置权"
    ],
    "evidence": [
      "ev_schema_disp"
    ]
  },
  {
    "id": "term_card",
    "name": "card",
    "type": "entity",
    "definition": "由金融机构发行、绑定到某一账户处置权、具有卡类型与发卡日期属性的支付凭证。 Counterexample: 与账户（account）不同：卡是账户的取用凭证，通过处置权（disp）间接关联账户。 Maturity: Provisional",
    "scope": "Records of table card; provenance: direct source card",
    "aliases": [
      "银行卡"
    ],
    "evidence": [
      "ev_schema_card"
    ]
  },
  {
    "id": "term_loan",
    "name": "loan",
    "type": "entity",
    "definition": "金融机构向账户发放的、具有金额、期限、还款额与状态属性的信贷资金安排。 Counterexample: 与交易（trans）不同：贷款是信贷合同安排，交易是账户资金的实际收付记录。 Maturity: Provisional",
    "scope": "Records of table loan; provenance: direct source loan",
    "aliases": [
      "贷款"
    ],
    "evidence": [
      "ev_schema_loan"
    ]
  },
  {
    "id": "term_order",
    "name": "order",
    "type": "entity",
    "definition": "由账户发起、指定收款银行与收款账号及金额的转账支付指令。 Counterexample: 与交易（trans）不同：汇款指令是发起的支付请求，交易是账户上实际发生的资金变动记录。 Maturity: Provisional",
    "scope": "Records of table order; provenance: direct source order",
    "aliases": [
      "汇款指令"
    ],
    "evidence": [
      "ev_schema_order"
    ]
  },
  {
    "id": "term_trans",
    "name": "trans",
    "type": "concept",
    "definition": "在某一账户上发生的、具有日期、类型、操作方式、金额与余额属性的资金收付事件。 Counterexample: 与贷款（loan）不同：交易是账户资金的实际变动事件，贷款是信贷合同安排。 Maturity: Provisional",
    "scope": "Records of table trans; provenance: direct source trans",
    "aliases": [
      "交易"
    ],
    "evidence": [
      "ev_schema_trans"
    ]
  },
