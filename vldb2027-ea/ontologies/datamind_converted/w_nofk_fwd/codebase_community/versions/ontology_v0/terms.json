[
  {
    "id": "term_users",
    "name": "users",
    "type": "entity",
    "definition": "在问答社区中注册并拥有账户的自然人，以唯一标识、显示名称和声誉值等属性区别于其他注册者。 Counterexample: 与「账户」辨析：账户是登录凭据载体，用户是社区中的行为主体；同一自然人可能对应多个账户。 Maturity: Provisional",
    "scope": "Records of table users; provenance: direct source users",
    "aliases": [
      "用户"
    ],
    "evidence": [
      "ev_schema_users"
    ]
  },
  {
    "id": "term_badges",
    "name": "badges",
    "type": "entity",
    "definition": "记录某用户在某时点获得某名称徽章的信息条目，以用户标识、徽章名称和授予日期为特征。 Counterexample: 与「徽章类型」辨析：徽章类型是可复用的定义（如“优秀回答者”），徽章授予记录是某用户获得该类型的一次具体事实。 Maturity: Provisional",
    "scope": "Records of table badges; provenance: direct source badges",
    "aliases": [
      "徽章授予记录"
    ],
    "evidence": [
      "ev_schema_badges"
    ]
  },
  {
    "id": "term_comments",
    "name": "comments",
    "type": "entity",
    "definition": "用户针对某篇帖子发表的文字性反馈信息条目，以所属帖子、作者、正文和创建时间为特征。 Counterexample: 与「帖子」辨析：帖子是独立发布的内容主体，评论是依附于帖子存在的反馈内容。 Maturity: Provisional",
    "scope": "Records of table comments; provenance: direct source comments",
    "aliases": [
      "评论"
    ],
    "evidence": [
      "ev_schema_comments"
    ]
  },
  {
    "id": "term_posthistory",
    "name": "postHistory",
    "type": "entity",
    "definition": "记录某篇帖子在某一时点发生某类变更的信息条目，以帖子标识、变更类型、修订标识和发生时间为特征。 Counterexample: 与「帖子」辨析：帖子是当前内容状态，修订历史是按时间累积的历次变更记录。 Maturity: Provisional",
    "scope": "Records of table postHistory; provenance: direct source postHistory",
    "aliases": [
      "帖子修订历史"
    ],
    "evidence": [
      "ev_schema_posthistory"
    ]
  },
  {
    "id": "term_postlinks",
    "name": "postLinks",
    "type": "entity",
    "definition": "记录两篇帖子之间存在某种关联关系的信息条目，以源帖子、目标帖子、关联类型和建立时间为特征。 Counterexample: 与「帖子」辨析：帖子是内容主体，帖子关联是描述两篇帖子之间关系的独立记录。 Maturity: Provisional",
    "scope": "Records of table postLinks; provenance: direct source postLinks",
    "aliases": [
      "帖子关联"
    ],
    "evidence": [
      "ev_schema_postlinks"
    ]
  },
  {
    "id": "term_posts",
    "name": "posts",
    "type": "entity",
    "definition": "用户在问答社区中发布的、具有标题与正文并可被评论和投票的内容条目，以发布者、类型、得分和创建时间为特征。 Counterexample: 与「评论」辨析：帖子是可独立检索和投票的内容主体，评论是依附于帖子的简短反馈。 Maturity: Provisional",
    "scope": "Records of table posts; provenance: direct source posts",
    "aliases": [
      "帖子"
    ],
    "evidence": [
      "ev_schema_posts"
    ]
  },
  {
    "id": "term_tags",
    "name": "tags",
    "type": "entity",
    "definition": "用于对帖子主题进行分类的受控词汇条目，以标签名称和使用计数为特征。 Counterexample: 与「帖子」辨析：标签是分类词汇，帖子是被分类的内容；标签本身不承载正文。 Maturity: Provisional",
    "scope": "Records of table tags; provenance: direct source tags",
    "aliases": [
      "标签"
    ],
    "evidence": [
      "ev_schema_tags"
    ]
  },
  {
    "id": "term_votes",
    "name": "votes",
